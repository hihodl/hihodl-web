{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "declaration": true,
    "sourceMap": false,
    "outDir": "dist/esm",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
